VITE_API_BASE_URL=https://taskmgr-api-dev.azurewebsites.net

# Set to true once you have a real Microsoft Entra External ID tenant configured (see root README)
VITE_AUTH_ENABLED=false
VITE_AUTH_CLIENT_ID=YOUR_SPA_CLIENT_ID
# https://<your-tenant-subdomain>.ciamlogin.com/ - no user-flow name in the URL
VITE_AUTH_AUTHORITY=https://<your-tenant>.ciamlogin.com/
# The API's exposed scope, from App Registration > Expose an API
VITE_AUTH_API_SCOPE=api://YOUR_API_CLIENT_ID/access_as_user